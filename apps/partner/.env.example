# Partner Convex (separate from Beam Core). Set these with
# `pnpm exec convex env set NAME value` from apps/partner.
# SITE_URL is the Better Auth fallback only. Request hosts are allowlisted.
SITE_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
STAFF_EMAIL_DOMAIN=beam.ai
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
PARTNER_MAGIC_LINK_FROM=
ALLOW_MAGIC_LINK_LOG=true
# Optional extra Better Auth hosts, comma-separated. Do not use for tenancy.
# PARTNER_AUTH_EXTRA_HOSTS=

# Next.js local Convex URLs. `convex dev` writes these to .env.local.
# Do not set NEXT_PUBLIC_CONVEX_URL or NEXT_PUBLIC_CONVEX_SITE_URL in Vercel.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Vercel: production CONVEX_DEPLOY_KEY on Production only; preview deploy key
# on Preview only. Same variable name, two values, two environments.

# Local/preview QA only. Never set on Vercel Production.
NEXT_PUBLIC_LOCAL_AUTH_BYPASS=false
NEXT_PUBLIC_PARTNER_BYPASS_WORKSPACE=
NEXT_PUBLIC_PARTNER_BYPASS_EMAIL=
