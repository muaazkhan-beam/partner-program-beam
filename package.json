{
  "name": "partner-program-beam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @beam-core/partner dev",
    "build": "pnpm --filter @beam-core/partner build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @beam-core/partner test:e2e",
    "catalog:compile": "pnpm --filter @beam-core/partner catalog:compile",
    "convex:dev": "pnpm --filter @beam-core/partner convex:dev"
  }
}
